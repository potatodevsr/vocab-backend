/.DS_Store
/.env
/node_modules

# Local secrets for `wrangler dev` and the e2e suite. Wrangler never uploads this file,
# but nothing stopped `git add -A` from committing it — and it is where a real
# GOOGLE_CLIENT_SECRET goes once Google sign-in is configured locally.
/.dev.vars

# Local databases — never commit data
/dev.backup-before-merge-pos.db
/dev.db
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3

# Wrangler local state: miniflare's D1/KV/R2 files, build cache, and the isolated e2e
# database. Rebuilt by `pnpm db:migrate:local` + `pnpm db:seed:dev`.
/.wrangler/

# Generated SQL seed for dev — rebuilt from data/vocab_review.csv on demand.
# seed/e2e.sql IS committed: e2e determinism depends on those exact fixture bytes.
/seed/dev.sql

# Prisma's compiled query engine, restored by `prisma generate`
/prisma/generated/prisma/internal/query_compiler_fast_bg.wasm
/prisma/generated/prisma/internal/query_compiler_fast_bg.js

# AI content pipeline (scripts/ai-extract-memmoread.mjs, ai-generate-word-content.mjs,
# sync-words-to-remote.mjs). Everything these write is local working state: page strips,
# per-pass model answers (~1,600 JSON files), apply/rollback SQL, review spreadsheets,
# and D1 exports — which contain the User table, password hashes included, so they must
# never be committed. Only the hand-checked golden set is source.
/data/ai-extract/*
!/data/ai-extract/golden.json
/data/ai-generate/
/data/sync/
